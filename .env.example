APP_NAME=Hirely API

APP_VERSION=0.1.0

ENVIRONMENT=development

DEBUG=false

DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/hirely

JWT_SECRET_KEY=your_jwt_secret_key

JWT_ALGORITHM=HS256

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

GEMINI_API_KEY=your_gemini_api_key

GEMINI_MODEL=gemini-3.5-flash-lite

GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Comma-separated list of allowed CORS origins or JSON list
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Reverse proxy trust setting (set true only behind trusted reverse proxies)
TRUST_PROXY_HEADERS=false

# Resume upload storage path (relative to backend root or absolute)
RESUME_STORAGE_DIR=app/storage/resumes

# Database Connection Pool Settings (per worker process)
# Formula: maximum connections = (DB_POOL_SIZE + DB_MAX_OVERFLOW) * worker processes
# Default: (5 + 10) * 4 workers = 60 connections, safely under PostgreSQL default max_connections (100)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
