APP_NAME=Hirely API

APP_VERSION=0.1.0

ENVIRONMENT=development

DEBUG=false

DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/hirely

JWT_SECRET_KEY=your_jwt_secret_key

JWT_ALGORITHM=HS256

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

GEMINI_API_KEY=your_gemini_api_key

GEMINI_MODEL=gemini-3.5-flash-lite

GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Comma-separated list of allowed CORS origins or JSON list
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Reverse proxy trust setting (set true only behind trusted reverse proxies)
TRUST_PROXY_HEADERS=false

# Resume upload storage path (relative to backend root or absolute, for local backend)
RESUME_STORAGE_DIR=app/storage/resumes

# Storage Backend: 'local' (default) or 'r2'
STORAGE_BACKEND=local

# Cloudflare R2 Configuration (required when STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hirely-resumes
# R2_ENDPOINT_URL is optional; auto-computed as https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=

# Database Connection Pool Settings (per worker process)
# Formula: maximum connections = (DB_POOL_SIZE + DB_MAX_OVERFLOW) * worker processes
# Default: (5 + 10) * 4 workers = 60 connections, safely under PostgreSQL default max_connections (100)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# ==============================================================================
# Docker Compose Local Setup
# ==============================================================================
POSTGRES_PORT=5433
POSTGRES_DB=hirely_dev
POSTGRES_USER=hirely_user
POSTGRES_PASSWORD=hirely_dev_password
FRONTEND_PORT=3000
BACKEND_PORT=8000
VITE_API_BASE_URL=http://localhost:8000
