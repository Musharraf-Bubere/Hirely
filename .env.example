APP_NAME=Hirely API

APP_VERSION=0.1.0

ENVIRONMENT=development

DEBUG=false

DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/hirely

JWT_SECRET_KEY=your_jwt_secret_key

JWT_ALGORITHM=HS256

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

GEMINI_API_KEY=your_gemini_api_key

GEMINI_MODEL=gemini-3.5-flash-lite

GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Comma-separated list of allowed CORS origins or JSON list
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Reverse proxy trust setting (set true only behind trusted reverse proxies)
TRUST_PROXY_HEADERS=false
